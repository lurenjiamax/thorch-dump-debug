pkgname=thorch-dump-debug
pkgver=0.1.0
pkgrel=7
pkgdesc='Opt-in AYN Thor hardlockup and panic firmware dump diagnostics'
arch=(aarch64)
license=('GPL-2.0-only')
depends=(linux-thorch linux-thorch-headers dkms python kmod systemd thorch-bsp)
options=('!strip' '!debug')

package() {
  local root="${startdir}/.."
  local dest="$pkgdir/usr/src/thorch-dump-debug-$pkgver"
  install -Dm644 "$root/module/dkms.conf" "$dest/dkms.conf"
  install -m644 "$root/module/Makefile" "$root/module/thorch-dump-watchdog.c" "$dest/"
  install -Dm755 "$root/bin/thorch-dump-debug" "$pkgdir/usr/bin/thorch-dump-debug"
  install -Dm755 "$root/bin/thorch-dumpctl" "$pkgdir/usr/bin/thorch-dumpctl"
  install -Dm644 "$root/packaging/thorch-dump-debug.service" "$pkgdir/usr/lib/systemd/system/thorch-dump-debug.service"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
